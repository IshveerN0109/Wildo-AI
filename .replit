modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
# ffmpeg is spawned by lib/integrations-openai-ai-server/src/audio/client.ts
# (ensureCompatibleFormat) to normalize recorded audio before sending it to
# Whisper for oral-practice speech-to-text. Without it that call fails with
# "ffmpeg ENOENT", breaking /oral-practice/evaluate end to end.
packages = ["ffmpeg"]
